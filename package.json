{
  "name": "dongphugia-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:public": "npm --prefix apps/public run build",
    "build:public-worker": "npm --prefix apps/public run build:worker",
    "build:admin": "npm --prefix apps/admin run build",
    "build:apps": "npm run build:public && npm run build:admin",
    "start": "next start",
    "lint": "node scripts/quality/lint-with-baseline.mjs",
    "lint:all": "eslint",
    "lint:baseline:update": "node scripts/quality/lint-with-baseline.mjs --update",
    "typecheck": "tsc --noEmit",
    "typecheck:public": "npm --prefix apps/public run typecheck",
    "check": "npm run lint && npm run typecheck && npm test",
    "audit:canonical-slugs": "tsx scripts/db/migrate-canonical-product-slugs.mts",
    "generate:redirect-map": "tsx scripts/db/export-product-redirect-map.mts",
    "check:canonical-rollout": "tsx scripts/db/check-canonical-rollout.mts",
    "db:migrate:postgres": "tsx scripts/db/postgres-migration-runner.ts",
    "db:manifest:postgres": "tsx scripts/db/postgres-schema-manifest.ts",
    "db:verify-schema:postgres": "tsx scripts/db/postgres-schema-verify.ts",
    "db:import:leo562": "tsx scripts/migration/leo562-import.ts",
    "staging:isolated": "tsx scripts/staging/isolated-staging.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:media": "vitest run src/lib/media src/app/api/upload-image",
    "test:homepage": "playwright test --config=playwright.homepage.config.ts",
    "perf:lighthouse": "lhci autorun",
    "perf:lighthouse:toilet": "lhci autorun --config=lighthouserc.toilet-listing.cjs && node scripts/quality/assert-lighthouse-toilet-median.mjs",
    "perf:lighthouse:production": "lhci autorun --config=lighthouserc.production.cjs",
    "monitor:probe": "node scripts/monitoring/https-probe.mjs",
    "monitor:verify-package": "node scripts/monitoring/verify-package.mjs",
    "monitor:test-sanitizer": "node scripts/monitoring/test-sanitizer.mjs",
    "publishing:scheduler": "node scripts/publishing/run-scheduler.mjs",
    "publishing:control": "tsx scripts/publishing/control.mts",
    "publishing:import-blog-media": "tsx scripts/publishing/import-blog-editorial-media.mts",
    "publishing:test-postgres-concurrency": "tsx scripts/publishing/test-postgres-concurrency.mts",
    "seo:build-inventory": "node scripts/seo/build-legacy-url-inventory.mjs",
    "seo:check-redirect-targets": "tsx scripts/seo/check-redirect-targets.ts",
    "static:build": "tsx scripts/static-build/public-static-build.mts",
    "static:check": "vitest run scripts/static-build/public-static-build.test.ts",
    "static:verify-preview-source": "tsx scripts/static-build/preview-source-attestation.mts",
    "static:verify-preview": "tsx scripts/static-build/preview-artifact-contract.mts",
    "app:detect-preview-change": "node scripts/app-foundation/preview-change-gate.mjs",
    "app:collect-artifact": "tsx scripts/app-foundation/app-artifact.mts",
    "app:create-candidate": "tsx scripts/app-foundation/preview-candidate.mts create",
    "app:verify-candidate": "tsx scripts/app-foundation/preview-candidate.mts verify",
    "app:runtime-proof": "tsx scripts/app-foundation/runtime-proof.mts",
    "app:assemble-public-worker": "tsx scripts/app-foundation/public-worker-artifact.mts",
    "app:preview-publication": "node scripts/app-foundation/cloudflare-preview-publication.mjs",
    "app:real-preview-proof": "node scripts/app-foundation/real-preview-proof.mjs",
    "app:foundation:check": "vitest run scripts/app-foundation apps/public/src apps/admin/src packages/app-contracts",
    "app:public-worker:check": "vitest run apps/public/src/worker-policy.test.ts scripts/app-foundation/public-worker-artifact.test.ts",
    "prepare:standalone-assets": "node -e \"const fs=require('fs'); fs.cpSync('public','.next/standalone/public',{recursive:true}); fs.mkdirSync('.next/standalone/.next',{recursive:true}); fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true});\"",
    "quality:homepage": "npm run test:media && npm run build && npm run prepare:standalone-assets && npm run test:homepage && npm run perf:lighthouse"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@next/third-parties": "^16.2.12",
    "@prisma/client": "5.22.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.75.0",
    "react-to-print": "^3.3.0",
    "sanitize-html": "^2.17.6",
    "sharp": "0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "yet-another-react-lightbox": "^3.32.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^28.1.0",
    "pg": "^8.20.0",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "form-data": "4.0.6",
    "linkify-it": "5.0.2",
    "markdown-it": "14.3.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.19",
    "sharp": "0.35.3",
    "undici": "7.28.0",
    "ws": "8.21.0"
  }
}
