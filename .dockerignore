.git
.github
.next
node_modules
npm-debug.log*
Dockerfile
.dockerignore

# Local environment files must never enter the image build context.
.env
.env.*
!.env.example

# Local/editor noise.
.DS_Store
coverage
playwright-report
test-results
*.log

# Project-local generated artefacts.
docs
scripts/*

# The production runner invokes the repository-owned one-shot scheduler with
# node, so this single non-secret entrypoint must remain in the build context.
!scripts/
scripts/*
!scripts/publishing/
scripts/publishing/*
!scripts/publishing/run-scheduler.mjs
