  actor_kind           String                         @db.VarChar(20)
  identity_id          String?                        @db.Uuid
  admin_actor_id       Int?
  sponsor_user_id      Int?
  action               String                         @db.VarChar(100)
  post_id              Int?
  external_id          String?                        @db.VarChar(200)
  request_id           String?                        @db.Uuid
  idempotency_key_hash String?                        @db.Char(64)
