  name                            String                          @db.VarChar(100)
  password_hash                   String                          @db.VarChar(255)
  role                            String                          @default("sale") @db.VarChar(20)
  is_active                       Boolean                         @default(true)
  avatar_url                      String?                         @db.VarChar(500)
  last_login_at                   DateTime?                       @db.Timestamptz(6)
  created_at                      DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime                        @default(now()) @db.Timestamptz(6)
  username                        String?                         @unique @db.VarChar(100)
  sessions                        admin_sessions[]
  audit_logs                      audit_logs[]
  publishing_sponsored_identities publishing_machine_identities[] @relation("publishing_identity_sponsor")
  publishing_audit_events         publishing_audit_events[]       @relation("publishing_audit_admin_actor")
