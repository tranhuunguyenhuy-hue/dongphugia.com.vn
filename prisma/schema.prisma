  @@index([email], map: "idx_admin_users_email")
  @@index([role], map: "idx_admin_users_role")
  @@index([is_active], map: "idx_admin_users_active")
}

/// Internal non-human identities authorized to use the Publishing API.
model publishing_machine_identities {
  id                  String                             @id @db.Uuid
  name                String                             @unique @db.VarChar(120)
  sponsor_user_id     Int
  is_active           Boolean                            @default(true)
  disabled_at         DateTime?                          @db.Timestamptz(6)
  disabled_reason     String?                            @db.VarChar(300)
  created_at          DateTime                           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                           @default(now()) @db.Timestamptz(6)
  sponsor             admin_users                        @relation("publishing_identity_sponsor", fields: [sponsor_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  capabilities        publishing_identity_capabilities[]
  credentials         publishing_credentials[]
  ip_allowlist        publishing_identity_ip_allowlist[]
  blog_posts          blog_posts[]
  managed_media       publishing_managed_media[]
  idempotency_records publishing_idempotency_records[]
  rate_limit_windows  publishing_rate_limit_windows[]
  audit_events        publishing_audit_events[]

  @@index([sponsor_user_id], map: "idx_publishing_identities_sponsor")
  @@index([is_active], map: "idx_publishing_identities_active")
}

model publishing_identity_capabilities {
  identity_id String                        @db.Uuid
  capability  String                        @db.VarChar(40)
  granted_at  DateTime                      @default(now()) @db.Timestamptz(6)
  revoked_at  DateTime?                     @db.Timestamptz(6)
  identity    publishing_machine_identities @relation(fields: [identity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([identity_id, capability])
  @@index([capability, revoked_at], map: "idx_publishing_capabilities_active")
}

model publishing_credentials {
  id                         String                        @id @db.Uuid
  identity_id                String                        @db.Uuid
  token_prefix               String                        @db.VarChar(32)
  token_hash                 String                        @unique @db.Char(64)
  environment                String                        @db.VarChar(20)
  issued_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  expires_at                 DateTime                      @db.Timestamptz(6)
  last_used_at               DateTime?                     @db.Timestamptz(6)
  revoked_at                 DateTime?                     @db.Timestamptz(6)
  revoke_reason              String?                       @db.VarChar(300)
  rotated_from_credential_id String?                       @db.Uuid
  identity                   publishing_machine_identities @relation(fields: [identity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rotated_from               publishing_credentials?       @relation("publishing_credential_rotation", fields: [rotated_from_credential_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  rotated_to                 publishing_credentials[]      @relation("publishing_credential_rotation")

  @@index([identity_id, environment, expires_at], map: "idx_publishing_credentials_identity")
  @@index([expires_at, revoked_at], map: "idx_publishing_credentials_expiry")
}

model publishing_identity_ip_allowlist {
  id          Int                           @id @default(autoincrement())
