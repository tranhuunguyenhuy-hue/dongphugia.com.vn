{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types"
    ],
    "paths": {
      "@/*": [
        "../../src/*"
      ],
      "@dpg/app-contracts": [
        "../../packages/app-contracts/src/index.ts"
      ],
      "@dpg/public-home-runtime": [
        "./src/runtime/preview-public-home.ts"
      ],
      "@dpg/public-interactions": [
        "./src/runtime/preview-public-interactions.ts"
      ],
      "@dpg/public-catalogue-runtime": [
        "./src/runtime/preview-public-catalogue.ts"
      ],
      "@/lib/public-api-products": [
        "./src/runtime/canonical-public-api.ts"
      ],
      "@/components/product/product-cta": [
        "./src/runtime/preview-product-cta.tsx"
      ],
      "@/components/home/hero-banner": [
        "./src/runtime/preview-hero.tsx"
      ],
      "@/components/category/category-sort": [
        "./src/runtime/preview-sort.tsx"
      ],
      "@/components/category/desktop-advanced-sidebar-filter": [
        "./src/runtime/preview-desktop-advanced-sidebar-filter.tsx"
      ],
      "@/components/category/category-mobile-filter": [
        "./src/runtime/preview-category-mobile-filter.tsx"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "worker.ts",
    "../../packages/app-contracts/src/**/*.ts",
    "../../src/app/(public)/page.tsx",
    "../../src/app/(public)/layout.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
