{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteDongphugiaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-1:*:log-group:/dongphugia/production/*"
    },
    {
      "Sid": "PublishDongphugiaMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "Dongphugia/EC2"
        }
      }
    }
  ]
}
