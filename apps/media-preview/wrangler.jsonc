{
  "$schema": "../../apps/public/node_modules/wrangler/config-schema.json",
  "name": "dongphugia-v1-media-preview",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": true,
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "APP_ENV": "preview",
    "PREVIEW_NOINDEX": "true"
  }
}
