/// Minimal immutable media inventory used to prove ownership and readiness.
model publishing_managed_media {
  id            String                        @id @db.Uuid
  identity_id   String                        @db.Uuid
  purpose       String                        @db.VarChar(20)
  status        String                        @default("processing") @db.VarChar(20)
  source_mime   String                        @db.VarChar(50)
  source_bytes  Int
  source_sha256 String                        @db.Char(64)
  source_width  Int?
  source_height Int?
  storage_path  String                        @unique @db.VarChar(500)
  primary_url   String?                       @unique @db.VarChar(1000)
  variants      Json?
  created_at    DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                      @default(now()) @db.Timestamptz(6)
  identity      publishing_machine_identities @relation(fields: [identity_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
