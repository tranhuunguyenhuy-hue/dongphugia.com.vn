  @@unique([publishing_identity_id, external_id], map: "uq_blog_posts_publishing_external")
  @@index([category_id], map: "idx_blog_posts_category")
  @@index([is_featured], map: "idx_blog_posts_featured")
  @@index([published_at], map: "idx_blog_posts_published")
  @@index([slug], map: "idx_blog_posts_slug")
  @@index([status], map: "idx_blog_posts_status")
  @@index([publishing_identity_id, updated_at(sort: Desc), id(sort: Desc)], map: "idx_blog_posts_publishing_list")
  @@index([publishing_identity_id, status, updated_at(sort: Desc), id(sort: Desc)], map: "idx_blog_posts_publishing_status")
  @@index([status, scheduled_for, id], map: "idx_blog_posts_scheduler")
}

