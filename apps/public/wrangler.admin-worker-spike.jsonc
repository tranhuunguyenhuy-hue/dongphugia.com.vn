{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dpg-admin-worker-spike-local-only",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "../admin-worker-spike/worker.admin-spike.ts",
  "workers_dev": false,
  "preview_urls": false,
  // This disposable local binding bypasses Hyperdrive query caching. The
  // production counterpart must be created or verified with --caching-disabled
  // because Admin auth/session/read-after-write traffic requires fresh reads.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_ADMIN_NO_CACHE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://dpg_worker_spike:local-only-spike-pass-20261113@127.0.0.1:55439/dpg_admin_worker_spike?sslmode=disable"
    }
  ],
  "limits": { "cpu_ms": 10 },
  "vars": {
    "APP_ENV": "preview",
    "RUNTIME_ROLE": "production",
    "WRITE_FREEZE_MODE": "false",
    "PREVIEW_NOINDEX": "true"
  }
}
