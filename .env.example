# Environment Variables
# Copy this file to .env and fill in the values

# Database — Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# NextAuth — Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"

# Publishing API v1 — values are environment-specific. Do not put production
# secrets in this file or commit a populated .env file.
PUBLISHING_ENVIRONMENT="staging"
PUBLISHING_EXTERNAL_LINK_HOSTNAMES=""
PUBLISHING_JSON_RATE_LIMIT_MAX="60"
PUBLISHING_MEDIA_RATE_LIMIT_MAX="20"
PUBLISHING_RATE_LIMIT_WINDOW_SECONDS="60"
PUBLISHING_TRUSTED_PROTO_HEADER="x-forwarded-proto"
PUBLISHING_TRUSTED_CLIENT_IP_HEADER=""
PUBLISHING_BUNNY_STORAGE_ENVIRONMENT="staging"
PUBLISHING_BUNNY_STORAGE_ZONE_NAME=""
PUBLISHING_BUNNY_STORAGE_API_KEY=""
PUBLISHING_BUNNY_STORAGE_HOSTNAME=""
PUBLISHING_BUNNY_CDN_HOSTNAME=""
PUBLISHING_SCHEDULER_TOKEN=""
PUBLISHING_SCHEDULER_URL="http://127.0.0.1:3000"
